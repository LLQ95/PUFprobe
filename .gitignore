# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/

# PUFprobe working directories (analysis outputs, never commit)
workdir/
work/
_shots/

# Downloaded databases and model weights (large, fetched via docs/server_setup.md).
# Anchored to the repository root so source packages such as src/pufprobe/db
# are not mistaken for downloaded data.
/databases/
/db/
/models/
/weights/
*.npz
!examples/**/*.npz

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Server runtime (server/ scripts): databases, third-party tools, and outputs
# are produced on the server and are never committed
dbs/
thirdparty/
runs/
annotations/
results/
logs/
server/logs/
# Local debugging artifacts generated during development
server/p2rank_test/
server/name_filter_flow.html

